BODHAN_API_KEY =
OPENROUTER_API_KEY=
STUDIO_DATA_DIR=./data
# Optional separate key authorized for indic-ocr; falls back to BODHAN_API_KEY.
BODHAN_OCR_API_KEY=
STUDIO_OCR_DPI=150
# Optional directory containing Noto .ttf/.otf fonts, including Indic scripts.
STUDIO_FONT_DIR=
STUDIO_MAX_UPLOAD_MB=25
# XML batches stay on one page; the character cap includes escaped text and tags.
STUDIO_TRANSLATION_BATCH_SIZE=30
STUDIO_TRANSLATION_BATCH_CHARS=6000
# Reprocess on every request; keep revision history but do not reuse cached work.
STUDIO_CACHE_ENABLED=false

# Local final-pass typography: compare relative source/output sizes of neighbours.
STUDIO_TYPOGRAPHY_ENABLED=true
STUDIO_TYPOGRAPHY_MIN_FONT_PT=6
STUDIO_TYPOGRAPHY_MAX_REFITS=24

# Optional external vision review. OFF until explicitly enabled.
# Enabling sends source/output crops of flagged regions to the selected provider.
# openrouter uses OPENROUTER_API_KEY above; deepseek uses DEEPSEEK_API_KEY below.
STUDIO_VISION_REVIEW_ENABLED=false
STUDIO_VISION_PROVIDER=openrouter
# Empty selects deepseek/deepseek-v4.1-flash-1017 on OpenRouter,
# or deepseek-flash on the direct DeepSeek API. Must support image inputs.
STUDIO_VISION_MODEL=
DEEPSEEK_API_KEY=
STUDIO_VISION_MAX_REGIONS=3
STUDIO_VISION_TIMEOUT_SECONDS=20
