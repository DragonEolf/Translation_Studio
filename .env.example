BODHAN_API_KEY=
STUDIO_DATA_DIR=./data
# Optional separate key authorized for indic-ocr; falls back to BODHAN_API_KEY.
BODHAN_OCR_API_KEY=
STUDIO_OCR_DPI=150
# Bundled Noto fonts; run the application from the repository root.
STUDIO_FONT_DIR=./fonts
STUDIO_MAX_UPLOAD_MB=25
# Parallel jobs per application process.
STUDIO_WORKERS=4
# XML batches stay on one page; the character cap includes escaped text and tags.
STUDIO_TRANSLATION_BATCH_SIZE=30
STUDIO_TRANSLATION_BATCH_CHARS=6000
# Reprocess on every request; keep revision history but do not reuse cached work.
STUDIO_CACHE_ENABLED=false

# Local final-pass typography: compare relative source/output sizes of neighbours.
STUDIO_TYPOGRAPHY_ENABLED=true
STUDIO_TYPOGRAPHY_MIN_FONT_PT=6
STUDIO_TYPOGRAPHY_MAX_REFITS=24

# User-requested AI repair from the review changes queue (vision + text).
# No repair calls run automatically during translation.
OPENROUTER_API_KEY=
STUDIO_REPAIR_MODEL=openai/gpt-4.1
STUDIO_REPAIR_MAX_REGIONS=20
STUDIO_REPAIR_TIMEOUT_SECONDS=60
